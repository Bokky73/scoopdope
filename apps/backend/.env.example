# JWT configuration
# JWT_SECRET must be set and at least 32 characters long, otherwise the app will fail to start.
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars

# Google OAuth configuration
# Comma-separated whitelist of allowed redirect URIs for the Google OAuth callback.
# The callback will reject (or fall back to the first entry) any redirect URI not listed here.
GOOGLE_OAUTH_REDIRECT_URI_WHITELIST=http://localhost:3000/auth/google/callback
